# ==================================================
# ESM WEB - ENVIRONMENT EXAMPLE
# Copy this file to .env for local development.
# Do not put real passwords, employee data, tokens, or email credentials here.
# Do not commit .env.
# ==================================================

DATABASE_URL="postgresql://esm_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/esm_dev"

APP_NAME="Employee Services Management"
APP_ENV="development"
APP_URL="http://localhost:3000"

STORAGE_ROOT="./storage"

# Leave email values blank until a development-only mailbox is configured.
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""
